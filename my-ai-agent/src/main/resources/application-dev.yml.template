spring:
  datasource:
    url: jdbc:mysql://localhost:3306/ai_agent?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
    username: your_username
    password: your_password
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    hibernate:
      ddl-auto: validate
    open-in-view: false
    properties:
      hibernate:
        format_sql: true
  flyway:
    enabled: true
    locations: classpath:db/migration
  data:
    redis:
      host: localhost
      port: 6379
      timeout: 3000ms
  ai:
    openai:
      api-key: YOUR_API_KEY
      base-url: https://api.deepseek.com
      chat:
        options:
          model: deepseek-chat
          temperature: 0.7

logging:
  level:
    com.qian.agent: DEBUG
    org.springframework.ai: DEBUG

agent:
  memory:
    max-messages: 20
  session:
    cache-ttl-minutes: 60
